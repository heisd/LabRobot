# External source deps pulled with vcstool (not vendored into this repo).
#   sudo apt install python3-vcstool   # if you don't have it
#   cd <workspace_root>                # the dir that contains src/
#   vcs import src < yolo_ros.repos    # -> src/yolo_ros (yolo_msgs / yolo_ros / yolo_bringup)
#   vcs pull src                       # later, to update
#
# yolo_ros: https://github.com/mgonzs13/yolo_ros  (ROS 2 wrapper for Ultralytics YOLO)
# Pin `version` to a tag/commit instead of `main` for reproducible robot builds.
repositories:
  yolo_ros:
    type: git
    url: https://github.com/mgonzs13/yolo_ros.git
    version: main
