<?xml version="1.0" ?>
<!-- =========================================================================
  grab_world.world — 抓取仿真场景(Gazebo Classic)。

  含: 地面、阳光、一张桌子, 以及几个标准模型物体(可乐罐/木块/啤酒)。
  所有模型从本地 ~/.gazebo/models 目录加载，无需联网下载。
  在 Gazebo GUI 左侧 "Insert" 面板可以继续拖入更多标准物体或你自己的机械臂模型。
========================================================================= -->
<sdf version="1.6">
  <world name="grab_world">

    <include><uri>model:///home/user/.gazebo/models/ground_plane</uri></include>
    <include><uri>model:///home/user/.gazebo/models/sun</uri></include>

    <!-- 桌子: 桌面约 1.0m 高 -->
    <include>
      <name>table</name>
      <uri>model:///home/user/.gazebo/models/table</uri>
      <pose>0.55 0 0 0 0 0</pose>
    </include>

    <!-- 标准物体(放在桌面上 ~1.015m) -->
    <include>
      <name>coke_can</name>
      <uri>model:///home/user/.gazebo/models/coke_can</uri>
      <pose>0.45 0.10 1.015 0 0 0</pose>
    </include>
    <include>
      <name>wood_cube</name>
      <uri>model:///home/user/.gazebo/models/wood_cube_5cm</uri>
      <pose>0.45 -0.10 1.015 0 0 0</pose>
    </include>
    <include>
      <name>beer</name>
      <uri>model:///home/user/.gazebo/models/beer</uri>
      <pose>0.60 0.0 1.015 0 0 0</pose>
    </include>

    <!-- ===================== 场景相机(转发到 Web) ===================== -->
    <!-- 斜俯视桌面与机械臂, 把画面发布成 /sim_scene/arm/image_raw,
         web_video_server 转 MJPEG 供 Dashboard"机械臂仿真"页显示整个抓取仿真场景。 -->
    <model name="scene_camera">
      <static>true</static>
      <pose>1.8 -1.3 1.7 0 0.35 2.4</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
        </visual>
        <sensor type="camera" name="scene_cam">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera name="scene">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <plugin name="scene_cam_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/sim_scene/arm</namespace>
              <remapping>scene/image_raw:=image_raw</remapping>
              <remapping>scene/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>scene</camera_name>
            <frame_name>scene_camera</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- 物理 -->
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- GUI 视角 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.8 -1.3 1.7 0 0.35 2.4</pose>
      </camera>
    </gui>

  </world>
</sdf>
