<?xml version="1.0" ?>
<!-- =========================================================================
  grab_vlm.world — 机械臂"VLM 自然语言抓取"世界(Gazebo Classic 11)。

  功能定位: grab_demo 的 vlm_grab(视觉语言模型按一句话选物抓取)。
  桌上摆多样、可命名的物体: 可乐罐 / 啤酒瓶 / 碗 / 杯子 / 锤子, 便于用自然语言
  ("把锤子递给我""我渴了"→拿饮料)测试 VLM 选物, 验证理解→抓取。

  模型取自本机 ~/.gazebo/models。场景相机发布 /sim_scene/arm/image_raw。
========================================================================= -->
<sdf version="1.6">
  <world name="grab_vlm">

    <include><uri>model:///home/user/.gazebo/models/ground_plane</uri></include>
    <include><uri>model:///home/user/.gazebo/models/sun</uri></include>

    <include>
      <name>table</name>
      <uri>model:///home/user/.gazebo/models/table</uri>
      <pose>0.55 0 0 0 0 0</pose>
    </include>

    <include>
      <name>coke_can</name>
      <uri>model:///home/user/.gazebo/models/coke_can</uri>
      <pose>0.42 0.16 1.015 0 0 0</pose>
    </include>
    <include>
      <name>beer_bottle</name>
      <uri>model:///home/user/.gazebo/models/beer</uri>
      <pose>0.42 -0.16 1.015 0 0 0</pose>
    </include>
    <include>
      <name>bowl</name>
      <uri>model:///home/user/.gazebo/models/bowl</uri>
      <pose>0.63 0.14 1.015 0 0 0</pose>
    </include>
    <include>
      <name>plastic_cup</name>
      <uri>model:///home/user/.gazebo/models/plastic_cup</uri>
      <pose>0.63 -0.14 1.015 0 0 0</pose>
    </include>
    <include>
      <name>hammer</name>
      <uri>model:///home/user/.gazebo/models/hammer</uri>
      <pose>0.52 0.0 1.015 0 0 1.5708</pose>
    </include>

    <!-- ===================== 场景相机(转发到 Web /sim_scene/arm/image_raw) ===================== -->
    <model name="scene_camera">
      <static>true</static>
      <pose>1.8 -1.3 1.7 0 0.35 2.4</pose>
      <link name="link">
        <visual name="vis"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></visual>
        <sensor type="camera" name="scene_cam">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera name="scene">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <plugin name="scene_cam_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/sim_scene/arm</namespace>
              <remapping>scene/image_raw:=image_raw</remapping>
              <remapping>scene/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>scene</camera_name>
            <frame_name>scene_camera</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>1.8 -1.3 1.7 0 0.35 2.4</pose></camera>
    </gui>

  </world>
</sdf>
