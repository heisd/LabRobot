<?xml version="1.0" ?>
<!-- =========================================================================
  grab_yolo.world — 机械臂"YOLO 抓取"世界(Gazebo Classic 11)。

  功能定位: grab_demo 的 yolo_ros_grab / yolo_grab(按 YOLO 类别选物抓取)。
  桌上摆了几样 YOLO(COCO)能识别的常见物体: 啤酒瓶(bottle)、塑料杯(cup)、碗(bowl)、
  可乐罐。在 Dashboard"YOLO 抓取"页点物体按钮或填 target_label(如 bottle/cup/bowl)
  即可指定抓取目标, 验证识别→抓取闭环。

  模型取自本机 ~/.gazebo/models。场景相机发布 /sim_scene/arm/image_raw。
========================================================================= -->
<sdf version="1.6">
  <world name="grab_yolo">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- 桌心 x=0.85(近沿 0.45), 与机器人前缘留出净空 -->
    <include>
      <name>table</name>
      <uri>model://table</uri>
      <pose>0.85 0 -0.45 0 0 1.5708</pose>
    </include>

    <include>
      <name>beer_bottle</name>
      <uri>model://beer</uri>
      <pose>0.52 0.15 0.565 0 0 0</pose>
    </include>
    <include>
      <name>plastic_cup</name>
      <uri>model://plastic_cup</uri>
      <pose>0.52 -0.15 0.565 0 0 0</pose>
    </include>
    <include>
      <name>bowl</name>
      <uri>model://bowl</uri>
      <pose>0.62 0.0 0.565 0 0 0</pose>
    </include>
    <include>
      <name>coke_can</name>
      <uri>model://coke_can</uri>
      <pose>0.58 0.2 0.565 0 0 0</pose>
    </include>

    <!-- ===================== 场景相机(转发到 Web /sim_scene/arm/image_raw) ===================== -->
    <model name="scene_camera">
      <static>true</static>
      <pose>1.8 -1.3 1.7 0 0.35 2.4</pose>
      <link name="link">
        <visual name="vis"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></visual>
        <sensor type="camera" name="scene_cam">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera name="scene">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <plugin name="scene_cam_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/sim_scene/arm</namespace>
              <remapping>scene/image_raw:=image_raw</remapping>
              <remapping>scene/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>scene</camera_name>
            <frame_name>scene_camera</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>1.8 -1.3 1.7 0 0.35 2.4</pose></camera>
    </gui>

  </world>
</sdf>
