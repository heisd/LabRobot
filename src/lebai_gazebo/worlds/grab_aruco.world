<?xml version="1.0" ?>
<!-- =========================================================================
  grab_aruco.world — 机械臂"ArUco 标记抓取"世界(Gazebo Classic 11)。

  功能定位: grab_demo 的 aruco_grab(aruco_node 识别 ArUco 标记并广播目标 TF 后抓取)。
  桌上平放一张 ArUco 标记牌(model://aruco_marker, 边长 0.05m, 与 aruco_grab.launch.py
  的 markerLength 一致), 眼在手相机俯视识别。

  ⚠ aruco_marker 的纹理默认是占位图(不可识别)! 先运行
     python3 src/lebai_gazebo/scripts/make_aruco_marker.py
  生成真正可被 aruco_node(dictionary_id 6)识别的标记后再用。model:// 由本包
  GAZEBO_MODEL_PATH 钩子解析(需先 colcon build + source install/setup.bash)。
========================================================================= -->
<sdf version="1.6">
  <world name="grab_aruco">

    <include><uri>model:///home/user/.gazebo/models/ground_plane</uri></include>
    <include><uri>model:///home/user/.gazebo/models/sun</uri></include>

    <include>
      <name>table</name>
      <uri>model:///home/user/.gazebo/models/table</uri>
      <pose>0.55 0 0 0 0 0</pose>
    </include>

    <!-- ArUco 标记牌(平放桌面, 正面朝上) -->
    <include>
      <name>aruco_marker</name>
      <uri>model://aruco_marker</uri>
      <pose>0.50 0.0 1.015 0 0 0</pose>
    </include>
    <!-- 抓取目标物(标记贴在它旁边/上方, 这里放一个木块作被抓物) -->
    <include>
      <name>wood_cube</name>
      <uri>model:///home/user/.gazebo/models/wood_cube_5cm</uri>
      <pose>0.50 0.14 1.015 0 0 0</pose>
    </include>

    <!-- ===================== 场景相机(转发到 Web /sim_scene/arm/image_raw) ===================== -->
    <model name="scene_camera">
      <static>true</static>
      <pose>1.8 -1.3 1.7 0 0.35 2.4</pose>
      <link name="link">
        <visual name="vis"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></visual>
        <sensor type="camera" name="scene_cam">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <camera name="scene">
            <horizontal_fov>1.2</horizontal_fov>
            <image><width>960</width><height>540</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>50</far></clip>
          </camera>
          <plugin name="scene_cam_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/sim_scene/arm</namespace>
              <remapping>scene/image_raw:=image_raw</remapping>
              <remapping>scene/camera_info:=camera_info</remapping>
            </ros>
            <camera_name>scene</camera_name>
            <frame_name>scene_camera</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>1.8 -1.3 1.7 0 0.35 2.4</pose></camera>
    </gui>

  </world>
</sdf>
